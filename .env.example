# drift-agent model provider (OpenAI-compatible /chat/completions + Bearer auth).
# Only the OPENROUTER_* names below are read (src/drift_agent/model/openrouter.py).
# base_url is restricted to a code-level host allowlist (_ALLOWED_ENDPOINTS);
# widen that constant before pointing it at a new host.

# ── Provider A: OpenRouter ──────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Provider B: OpenClaw (aggregator, same OpenAI-compatible shape) ──────
# To use OpenClaw instead, set these three (base path is /v1, not /api/v1):
# OPENROUTER_API_KEY=<openclaw key>
# OPENROUTER_MODEL=anthropic/claude-...      # exact sonnet id from GET /v1/models
# OPENROUTER_BASE_URL=https://openclaw-api.com/v1

# Optional:
# OPENROUTER_STRONG_MODEL=<provider/model>   # overrides for the "strong" profile
# OPENROUTER_FAST_MODEL=<provider/model>     # overrides for the "fast" profile
# OPENROUTER_TIMEOUT_SECONDS=120
