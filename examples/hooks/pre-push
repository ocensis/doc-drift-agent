#!/bin/sh
set -eu

remote_name=${1:-}

is_zero_oid() {
  case $1 in
    '' | *[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

if ! IFS=' ' read -r local_ref local_sha remote_ref remote_sha; then
  exit 0
fi
if IFS= read -r extra_ref; then
  echo "drift-agent: multi-ref pushes are not supported by this example hook" >&2
  exit 2
fi
if is_zero_oid "$local_sha"; then
  exit 0
fi
if is_zero_oid "$remote_sha"; then
  echo "drift-agent: first pushes need an explicit baseline; run ci check manually" >&2
  exit 2
fi

repo=$(git rev-parse --show-toplevel)
head_sha=$(git rev-parse HEAD)
if test "$local_sha" != "$head_sha"; then
  echo "drift-agent: this hook only checks a pushed ref at the current HEAD" >&2
  exit 2
fi
if ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
  echo "drift-agent: remote baseline is unavailable locally; fetch $remote_name first" >&2
  exit 2
fi

artifact_dir=$(mktemp -d "${TMPDIR:-/tmp}/drift-agent-pre-push.XXXXXX")
state_dir=$(mktemp -d "${TMPDIR:-/tmp}/drift-agent-pre-push-state.XXXXXX")
# The CI contract rejects lexical symlink components. `pwd -P` turns common
# macOS aliases such as /var -> /private/var into their physical paths.
artifact_dir=$(cd "$artifact_dir" && pwd -P)
state_dir=$(cd "$state_dir" && pwd -P)
drift_agent_bin=${DRIFT_AGENT_BIN:-drift-agent}
set +e
"$drift_agent_bin" ci check \
  --repo "$repo" \
  --since "$remote_sha" \
  --state-dir "$state_dir" \
  --artifacts-dir "$artifact_dir"
drift_exit_code=$?
set -e

if test -f "$artifact_dir/summary.md"; then
  cat "$artifact_dir/summary.md" >&2
fi
if test "$drift_exit_code" -eq 0; then
  rm -rf "$artifact_dir"
  rm -rf "$state_dir"
else
  echo "drift-agent: artifacts retained at $artifact_dir" >&2
  echo "drift-agent: run state retained at $state_dir" >&2
fi
exit "$drift_exit_code"
